APP_NAME=SoloTasks
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8092
APP_TIMEZONE=Europe/Rome
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

DB_CONNECTION=sqlite
SESSION_DRIVER=file
SESSION_COOKIE=sh_solotasks_session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

# One personal login. Generate the bcrypt hash with artisan solotasks:password.
SOLOTASKS_USERNAME=replace-with-your-username
SOLOTASKS_PASSWORD_HASH='replace-with-bcrypt-hash'
SOLOTASKS_CALENDAR_INCLUDE_DONE=false

# Docker Compose: bind to localhost by default.
SOLOTASKS_BIND_IP=127.0.0.1
SOLOTASKS_PORT=8092
SOLOTASKS_URL=http://localhost:8092

# Only used with compose.minipc.yaml. Create the directory before starting.
SOLOTASKS_BACKUP_DIR=/absolute/path/to/solotasks-backups

# Optional overrides for running a separate instance from this checkout.
# SOLOTASKS_IMAGE=sh-solotasks:local
# SOLOTASKS_ENV_FILE=.env
